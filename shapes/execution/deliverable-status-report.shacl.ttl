# shapes/execution/deliverable-status-report.shacl.ttl
#
# SHACL PRIMER — what is this file?
# ─────────────────────────────────
# SHACL (Shapes Constraint Language, W3C 2017) defines rules that an RDF graph
# must satisfy. Think of it as a type checker / schema validator for ontology data.
#
# When a Deliverable Status Report is "ingested" (converted from the filled
# template.md into RDF), this file is what tells us whether the RDF is valid.
#
# How to read a shape:
#
#   sh:targetClass pm:DeliverableStatusReport
#     → "these rules apply to any node of type pm:DeliverableStatusReport"
#
#   sh:property [ sh:path dct:title ; sh:minCount 1 ]
#     → "every DeliverableStatusReport instance must have at least one dct:title triple"
#
#   sh:message "..."
#     → the error message a human sees when validation fails
#
# To run validation:
#   pip install pyshacl
#   pyshacl -s shapes/execution/deliverable-status-report.shacl.ttl \
#            -d path/to/my-deliverable-status-report.ttl
#
# ── Prefixes ──────────────────────────────────────────────────────────────────

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix proj:  <https://linked.data.gov.au/def/project#> .
@prefix pm:    <https://stephen-mcelhose.github.io/project-management-ontology/> .
@prefix pm-sh: <https://stephen-mcelhose.github.io/project-management-ontology/shapes/> .

# ── Shape definition ──────────────────────────────────────────────────────────

pm-sh:DeliverableStatusReportShape
    a sh:NodeShape ;

    # Target: applies to any RDF node typed as pm:DeliverableStatusReport
    sh:targetClass pm:DeliverableStatusReport ;

    rdfs:label "Deliverable Status Report shape"@en ;
    rdfs:comment "Validates that a filled Deliverable Status Report instance satisfies the minimum information requirements of ISO 21502:2020 §8 and PRINCE2® Checkpoint Report quality criteria."@en ;

    # ── Required: title (work package reference) ────────────────────────────
    # Maps to the {{work_package_reference}} slot in template.md — identifies
    # which Work Package this report covers.
    sh:property [
        sh:path     dct:title ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 3 ;
        sh:message  "A Deliverable Status Report must have a dct:title identifying the Work Package it covers."@en ;
    ] ;

    # ── Required: description (reporting period) ────────────────────────────
    # Maps to the {{reporting_period}} and {{comparison_to_plan}} slots.
    sh:property [
        sh:path     dct:description ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "A Deliverable Status Report must have a dct:description (reporting period and comparison to plan)."@en ;
    ] ;

    # ── Required: at least one deliverable referenced ──────────────────────
    # Ensures the report addresses actual deliverable progress.
    sh:property [
        sh:path     pm:hasDeliverable ;
        sh:minCount 1 ;
        sh:class    pm:Deliverable ;
        sh:message  "A Deliverable Status Report must reference at least one deliverable (pm:hasDeliverable)."@en ;
    ] ;

    # ── Required: project link ──────────────────────────────────────────────
    sh:property [
        sh:path     pm:describesProject ;
        sh:minCount 1 ;
        sh:class    pm:Project ;
        sh:message  "A Deliverable Status Report must reference the project it belongs to via pm:describesProject."@en ;
    ] ;

    # ── Required: produced in Execution phase ───────────────────────────────
    sh:property [
        sh:path     pm:producedInPhase ;
        sh:minCount 1 ;
        sh:hasValue <https://stephen-mcelhose.github.io/project-management-ontology/phases/Execution> ;
        sh:message  "A Deliverable Status Report must be linked to the Execution phase."@en ;
    ] ;

    # ── Required: report date ───────────────────────────────────────────────
    sh:property [
        sh:path     dct:created ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message  "A Deliverable Status Report must record the date it was produced (dct:created)."@en ;
    ] ;

    # ── Required: creator (Team Manager who authored the report) ─────────────
    sh:property [
        sh:path     dct:creator ;
        sh:minCount 1 ;
        sh:message  "A Deliverable Status Report must identify the Team Manager who authored it (dct:creator)."@en ;
    ] .
