# shapes/closure/lessons-learned-report.shacl.ttl
#
# SHACL PRIMER — what is this file?
# ─────────────────────────────────
# SHACL (Shapes Constraint Language, W3C 2017) defines rules that an RDF graph
# must satisfy. Think of it as a type checker / schema validator for ontology data.
#
# When a Lessons Learned Report is "ingested" (converted from the filled template.md
# into RDF), this file is what tells us whether the RDF is valid.
#
# How to read a shape:
#
#   sh:targetClass pm:LessonsLearnedReport
#     → "these rules apply to any node of type pm:LessonsLearnedReport"
#
#   sh:property [ sh:path dct:title ; sh:minCount 1 ]
#     → "every LessonsLearnedReport instance must have at least one dct:title triple"
#
#   sh:message "..."
#     → the error message a human sees when validation fails
#
# To run validation:
#   pip install pyshacl
#   pyshacl -s shapes/closure/lessons-learned-report.shacl.ttl \
#            -d path/to/my-lessons-learned-report.ttl
#
# ── Prefixes ──────────────────────────────────────────────────────────────────

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix proj:  <https://linked.data.gov.au/def/project#> .
@prefix pm:    <https://stephen-mcelhose.github.io/project-management-ontology/> .
@prefix pm-sh: <https://stephen-mcelhose.github.io/project-management-ontology/shapes/> .

# ── Shape definition ──────────────────────────────────────────────────────────

pm-sh:LessonsLearnedReportShape
    a sh:NodeShape ;

    # Target: applies to any RDF node typed as pm:LessonsLearnedReport
    sh:targetClass pm:LessonsLearnedReport ;

    rdfs:label "Lessons Learned Report shape"@en ;
    rdfs:comment "Validates that a filled Lessons Learned Report instance satisfies the minimum information requirements of ISO 21502:2020 §9 and the PRINCE2® Lessons Report quality criteria."@en ;

    # ── Required: title ─────────────────────────────────────────────────────
    sh:property [
        sh:path     dct:title ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 3 ;
        sh:message  "A Lessons Learned Report must have a dct:title."@en ;
    ] ;

    # ── Required: description / project context and lessons ──────────────────
    sh:property [
        sh:path     dct:description ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "A Lessons Learned Report must have a dct:description (project context and lessons summary)."@en ;
    ] ;

    # ── Required: project link ───────────────────────────────────────────────
    sh:property [
        sh:path     pm:describesProject ;
        sh:minCount 1 ;
        sh:class    pm:Project ;
        sh:message  "A Lessons Learned Report must reference the project it describes via pm:describesProject."@en ;
    ] ;

    # ── Required: produced in Closure phase ──────────────────────────────────
    sh:property [
        sh:path     pm:producedInPhase ;
        sh:minCount 1 ;
        sh:hasValue <https://stephen-mcelhose.github.io/project-management-ontology/phases/Closure> ;
        sh:message  "A Lessons Learned Report must be linked to the Closure phase."@en ;
    ] ;

    # ── Required: creation date ──────────────────────────────────────────────
    sh:property [
        sh:path     dct:created ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message  "A Lessons Learned Report must record the date it was created (dct:created)."@en ;
    ] ;

    # ── Required: creator (report author) ────────────────────────────────────
    sh:property [
        sh:path     dct:creator ;
        sh:minCount 1 ;
        sh:message  "A Lessons Learned Report must identify its author (dct:creator)."@en ;
    ] ;

    # ── Required: risk reference ─────────────────────────────────────────────
    # The report must reference at least one risk lesson drawn from the Risk Register.
    sh:property [
        sh:path     pm:hasRisk ;
        sh:minCount 1 ;
        sh:message  "A Lessons Learned Report must include at least one risk management lesson (pm:hasRisk)."@en ;
    ] .
