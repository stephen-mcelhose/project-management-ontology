# shapes/planning/communication-plan.shacl.ttl
#
# SHACL PRIMER — what is this file?
# ─────────────────────────────────
# SHACL (Shapes Constraint Language, W3C 2017) defines rules that an RDF graph
# must satisfy. Think of it as a type checker / schema validator for ontology data.
#
# When a Communication Plan is "ingested" (converted from the filled template.md
# into RDF), this file is what tells us whether the RDF is valid.
#
# How to read a shape:
#
#   sh:targetClass pm:CommunicationPlan
#     → "these rules apply to any node of type pm:CommunicationPlan"
#
#   sh:property [ sh:path dct:title ; sh:minCount 1 ]
#     → "every CommunicationPlan instance must have at least one dct:title triple"
#
#   sh:message "..."
#     → the error message a human sees when validation fails
#
# To run validation:
#   pip install pyshacl
#   pyshacl -s shapes/planning/communication-plan.shacl.ttl \
#            -d path/to/my-communication-plan.ttl
#
# ── Prefixes ──────────────────────────────────────────────────────────────────

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix pm:    <https://stephen-mcelhose.github.io/project-management-ontology/> .
@prefix pm-sh: <https://stephen-mcelhose.github.io/project-management-ontology/shapes/> .

# ── Shape definition ──────────────────────────────────────────────────────────

pm-sh:CommunicationPlanShape
    a sh:NodeShape ;

    sh:targetClass pm:CommunicationPlan ;

    rdfs:label "Communication Plan shape"@en ;
    rdfs:comment "Validates that a filled Communication Plan instance satisfies the minimum requirements of ISO 21502:2020 and the PRINCE2® Communication Management Approach quality criteria."@en ;

    # ── Required: title ─────────────────────────────────────────────────────
    sh:property [
        sh:path     dct:title ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 3 ;
        sh:message  "A Communication Plan must have a dct:title (the project name)."@en ;
    ] ;

    # ── Required: description / scope ───────────────────────────────────────
    sh:property [
        sh:path     dct:description ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "A Communication Plan must have a dct:description (scope of communication management)."@en ;
    ] ;

    # ── Note on stakeholder analysis ────────────────────────────────────────
    # Stakeholder communication requirements are captured via pm:RoleAssignment
    # instances on the described pm:Project (pm:communicationApproach,
    # pm:stakeholderInterest, pm:influenceLevel, pm:currentEngagement,
    # pm:desiredEngagement). These are validated at the project level, not
    # directly on the CommunicationPlan document node.

    # ── Required: project link ──────────────────────────────────────────────
    sh:property [
        sh:path     pm:describesProject ;
        sh:minCount 1 ;
        sh:class    pm:Project ;
        sh:message  "A Communication Plan must reference the project it describes via pm:describesProject."@en ;
    ] ;

    # ── Required: produced in Planning phase ─────────────────────────────────
    sh:property [
        sh:path     pm:producedInPhase ;
        sh:minCount 1 ;
        sh:hasValue <https://stephen-mcelhose.github.io/project-management-ontology/phases/Planning> ;
        sh:message  "A Communication Plan must be linked to the Planning phase."@en ;
    ] ;

    # ── Required: creation date ──────────────────────────────────────────────
    sh:property [
        sh:path     dct:created ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message  "A Communication Plan must record the date it was created (dct:created)."@en ;
    ] ;

    # ── Required: creator ────────────────────────────────────────────────────
    sh:property [
        sh:path     dct:creator ;
        sh:minCount 1 ;
        sh:message  "A Communication Plan must identify its author (dct:creator)."@en ;
    ] .
