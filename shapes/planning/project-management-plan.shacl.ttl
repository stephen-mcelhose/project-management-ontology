# shapes/planning/project-management-plan.shacl.ttl
#
# SHACL PRIMER — what is this file?
# ─────────────────────────────────
# SHACL (Shapes Constraint Language, W3C 2017) defines rules that an RDF graph
# must satisfy. Think of it as a type checker / schema validator for ontology data.
#
# When a Project Management Plan is "ingested" (converted from the filled
# template.md into RDF), this file is what tells us whether the RDF is valid.
#
# How to read a shape:
#
#   sh:targetClass pm:ProjectManagementPlan
#     → "these rules apply to any node of type pm:ProjectManagementPlan"
#
#   sh:property [ sh:path dct:title ; sh:minCount 1 ]
#     → "every ProjectManagementPlan instance must have at least one dct:title triple"
#
#   sh:message "..."
#     → the error message a human sees when validation fails
#
# To run validation:
#   pip install pyshacl
#   pyshacl -s shapes/planning/project-management-plan.shacl.ttl \
#            -d path/to/my-project-management-plan.ttl
#
# ── Prefixes ──────────────────────────────────────────────────────────────────

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix proj:  <https://linked.data.gov.au/def/project#> .
@prefix pm:    <https://stephen-mcelhose.github.io/project-management-ontology/> .
@prefix pm-sh: <https://stephen-mcelhose.github.io/project-management-ontology/shapes/> .

# ── Shape definition ──────────────────────────────────────────────────────────

pm-sh:ProjectManagementPlanShape
    a sh:NodeShape ;

    sh:targetClass pm:ProjectManagementPlan ;

    rdfs:label "Project Management Plan shape"@en ;
    rdfs:comment "Validates that a filled Project Management Plan instance satisfies the minimum information requirements of ISO 21502:2020 and PRINCE2® PID quality criteria."@en ;

    # ── Required: title ─────────────────────────────────────────────────────
    sh:property [
        sh:path     dct:title ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 3 ;
        sh:message  "A Project Management Plan must have a dct:title (the project name)."@en ;
    ] ;

    # ── Required: description / purpose and scope ────────────────────────────
    sh:property [
        sh:path     dct:description ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "A Project Management Plan must have a dct:description (project purpose, scope, and direction)."@en ;
    ] ;

    # ── Required: project objectives ────────────────────────────────────────
    sh:property [
        sh:path     proj:purpose ;
        sh:minCount 1 ;
        sh:message  "A Project Management Plan must state project objectives (proj:purpose)."@en ;
    ] ;

    # ── Required: project approach ──────────────────────────────────────────
    sh:property [
        sh:path     pm:projectApproach ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "A Project Management Plan must state the project approach (pm:projectApproach)."@en ;
    ] ;

    # ── Required: tolerance ─────────────────────────────────────────────────
    sh:property [
        sh:path     pm:hasTolerance ;
        sh:minCount 1 ;
        sh:class    pm:Tolerance ;
        sh:message  "A Project Management Plan must define at least one tolerance (pm:hasTolerance)."@en ;
    ] ;

    # ── Required: project link ──────────────────────────────────────────────
    sh:property [
        sh:path     pm:describesProject ;
        sh:minCount 1 ;
        sh:class    pm:Project ;
        sh:message  "A Project Management Plan must reference the project it describes via pm:describesProject."@en ;
    ] ;

    # ── Required: produced in Planning phase ─────────────────────────────────
    sh:property [
        sh:path     pm:producedInPhase ;
        sh:minCount 1 ;
        sh:hasValue <https://stephen-mcelhose.github.io/project-management-ontology/phases/Planning> ;
        sh:message  "A Project Management Plan must be linked to the Planning phase."@en ;
    ] ;

    # ── Required: creation date ──────────────────────────────────────────────
    sh:property [
        sh:path     dct:created ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message  "A Project Management Plan must record the date it was created (dct:created)."@en ;
    ] ;

    # ── Required: creator ────────────────────────────────────────────────────
    sh:property [
        sh:path     dct:creator ;
        sh:minCount 1 ;
        sh:message  "A Project Management Plan must identify its author (dct:creator)."@en ;
    ] .
