@prefix :      <https://stephen-mcelhose.github.io/project-management-ontology/> .
@prefix phases: <https://stephen-mcelhose.github.io/project-management-ontology/phases/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

# ── Document Module ────────────────────────────────────────────────────────────
# Canonical set of project management documents, grounded in:
#
#   ISO 21502:2020  "Project, programme and portfolio management — Guidance on
#                    project management"  https://www.iso.org/standard/74947.html
#
#   DIN 69901-2:2009  "Projektmanagementsysteme — Prozesse, Prozessmodell"
#                      https://www.beuth.de/en/standard/din-69901-2/119948897
#
#   PRINCE2® 7th edition management products
#                      https://prince2.wiki/management-products/
#
# Design rules:
#   • Each class is a direct subclass of foaf:Document + prov:Entity
#   • pm:producedInPhase links each class to its DIN 69901 phase
#   • pm:hasHardDependency records production-order dependencies
#   • rdfs:seeAlso points to the closest PRINCE2 management product
#   • skos:scopeNote clarifies where the match is partial
#
# 27 classes across 5 phases.

# ── Cross-document dependency property ────────────────────────────────────────

:hasHardDependency
    a owl:ObjectProperty ;
    rdfs:domain foaf:Document ;
    rdfs:range foaf:Document ;
    rdfs:label "has hard dependency"@en ;
    rdfs:comment "A document that must already exist before this document can be produced. Encodes the logical production sequence of the project document lifecycle."@en ;
    rdfs:isDefinedBy : .

# ══════════════════════════════════════════════════════════════════════════════
# PHASE 1 — INITIATION
# ══════════════════════════════════════════════════════════════════════════════

:ProjectProposal
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Project Proposal"@en ;
    skos:altLabel "Project Brief"@en ;
    skos:definition "Outlines the initial project idea, high-level objectives, and justification to seek formal authorization."@en ;
    :producedInPhase phases:Initiation ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/baselines/project-brief/> ;
    rdfs:isDefinedBy : .

:BusinessCase
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Business Case"@en ;
    skos:definition "Provides the financial and strategic justification for the project, comparing expected costs against anticipated benefits."@en ;
    :producedInPhase phases:Initiation ;
    :hasHardDependency :ProjectProposal ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/baselines/business-case/> ;
    rdfs:isDefinedBy : .

:ProjectCharter
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Project Charter"@en ;
    skos:altLabel "Project Mandate"@en ;
    skos:definition "Formally authorizes the existence of the project and grants the project manager authority to apply resources to project activities."@en ;
    skos:scopeNote "In PRINCE2, formal authorization occurs within the Project Initiation Documentation (PID) stage rather than a standalone charter."@en ;
    :producedInPhase phases:Initiation ;
    :hasHardDependency :BusinessCase ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/baselines/project-initiation-documentation/> ;
    rdfs:isDefinedBy : .

:StakeholderRegister
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Stakeholder Register"@en ;
    skos:definition "Identifies all individuals and groups affected by or able to influence the project, recording their interests, involvement, and potential impact."@en ;
    skos:scopeNote "In PRINCE2 7, stakeholder analysis is captured within the Communication Management Approach rather than a dedicated register."@en ;
    :producedInPhase phases:Initiation ;
    :hasHardDependency :ProjectCharter ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/baselines/management-approaches/communication/> ;
    rdfs:isDefinedBy : .

:RequirementSpecification
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Requirement Specification"@en ;
    skos:altLabel "Requirements Document"@en ;
    skos:definition "Documents the high-level needs, expectations, and constraints of stakeholders that the project deliverables must satisfy."@en ;
    skos:scopeNote "Corresponds to the PRINCE2 Project Product Description, which defines the quality expectations and acceptance criteria for the project's final output."@en ;
    :producedInPhase phases:Initiation ;
    :hasHardDependency :StakeholderRegister ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/baselines/project-product-description/> ;
    rdfs:isDefinedBy : .

# ══════════════════════════════════════════════════════════════════════════════
# PHASE 2 — PLANNING
# ══════════════════════════════════════════════════════════════════════════════

:ProjectManagementPlan
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Project Management Plan"@en ;
    skos:definition "Consolidates all subsidiary plans into a single governing document that defines how the project will be executed, monitored, and controlled."@en ;
    skos:scopeNote "Equivalent to the PRINCE2 Project Initiation Documentation (PID), which consolidates all management approaches and the overall project plan."@en ;
    :producedInPhase phases:Planning ;
    :hasHardDependency :ProjectCharter ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/baselines/project-initiation-documentation/> ;
    rdfs:isDefinedBy : .

:WorkBreakdownStructure
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Work Breakdown Structure"@en ;
    skos:altLabel "WBS"@en ;
    skos:definition "Hierarchically decomposes the total project scope into manageable work packages and deliverables."@en ;
    skos:scopeNote "DIN 69901-3 calls this the Projektstrukturplan (PSP). In PRINCE2, the equivalent is the product breakdown structure embedded within the Plan."@en ;
    :producedInPhase phases:Planning ;
    :hasHardDependency :ProjectCharter ;
    dct:source <https://www.beuth.de/en/standard/din-69901-2/119948897> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/baselines/plan/> ;
    rdfs:isDefinedBy : .

:ProjectSchedule
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Project Schedule"@en ;
    skos:definition "Defines the planned sequence of project activities, their durations, and key milestones, forming the project time baseline."@en ;
    skos:scopeNote "Corresponds to the schedule component of the PRINCE2 Plan management product."@en ;
    :producedInPhase phases:Planning ;
    :hasHardDependency :WorkBreakdownStructure ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/baselines/plan/> ;
    rdfs:isDefinedBy : .

:ResourcePlan
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Resource Plan"@en ;
    skos:definition "Identifies the human, material, and financial resources required to complete project activities and their planned allocation."@en ;
    skos:scopeNote "In PRINCE2, resource requirements are embedded within the Plan management product rather than a standalone document."@en ;
    :producedInPhase phases:Planning ;
    :hasHardDependency :ProjectSchedule ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/baselines/plan/> ;
    rdfs:isDefinedBy : .

:CostEstimate
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Cost Estimate"@en ;
    skos:altLabel "Project Budget"@en ;
    skos:definition "Determines the total approved budget by aggregating estimated costs of individual activities and resources."@en ;
    skos:scopeNote "Cost information appears in both the PRINCE2 Business Case (benefit/cost ratio) and the Plan (cost baseline). Modelled here as a separate document per ISO 21502."@en ;
    :producedInPhase phases:Planning ;
    :hasHardDependency :ResourcePlan ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/baselines/business-case/> ;
    rdfs:isDefinedBy : .

:RiskManagementPlan
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Risk Management Plan"@en ;
    skos:definition "Defines how risks will be identified, analyzed, prioritized, and managed throughout the project lifecycle."@en ;
    skos:scopeNote "Equivalent to the PRINCE2 Risk Management Approach, one of the nine management approaches in PRINCE2 7."@en ;
    :producedInPhase phases:Planning ;
    :hasHardDependency :ProjectCharter ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/baselines/management-approaches/risk/> ;
    rdfs:isDefinedBy : .

:QualityManagementPlan
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Quality Management Plan"@en ;
    skos:definition "Establishes the quality standards, criteria, and assurance activities that project deliverables must satisfy."@en ;
    skos:scopeNote "Equivalent to the PRINCE2 Quality Management Approach."@en ;
    :producedInPhase phases:Planning ;
    :hasHardDependency :RequirementSpecification ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/baselines/management-approaches/quality/> ;
    rdfs:isDefinedBy : .

:CommunicationPlan
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Communication Plan"@en ;
    skos:definition "Outlines the information needs of stakeholders and the methods, frequency, and responsibilities for distributing project information."@en ;
    skos:scopeNote "Equivalent to the PRINCE2 Communication Management Approach."@en ;
    :producedInPhase phases:Planning ;
    :hasHardDependency :StakeholderRegister ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/baselines/management-approaches/communication/> ;
    rdfs:isDefinedBy : .

# ══════════════════════════════════════════════════════════════════════════════
# PHASE 3 — EXECUTION
# ══════════════════════════════════════════════════════════════════════════════

:WorkPackageDescription
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Work Package Description"@en ;
    skos:definition "Provides detailed instructions, acceptance criteria, and resource information for team members performing a specific work package."@en ;
    skos:scopeNote "Directly equivalent to the PRINCE2 Work Package management product."@en ;
    :producedInPhase phases:Execution ;
    :hasHardDependency :WorkBreakdownStructure ;
    :hasHardDependency :ProjectSchedule ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/baselines/work-package/> ;
    rdfs:isDefinedBy : .

:DeliverableStatusReport
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Deliverable Status Report"@en ;
    skos:definition "Tracks the progress and completion status of individual project deliverables against the planned schedule."@en ;
    skos:scopeNote "Corresponds to the PRINCE2 Checkpoint Report, produced by teams to report progress on their work packages."@en ;
    :producedInPhase phases:Execution ;
    :hasHardDependency :ProjectSchedule ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/reports/checkpoint-report/> ;
    rdfs:isDefinedBy : .

:ChangeRequest
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Change Request"@en ;
    skos:definition "Documents a formal proposal to modify any aspect of the project baseline — scope, schedule, budget, or quality."@en ;
    skos:scopeNote "Corresponds to the PRINCE2 Issue Report when the issue is a request for change (RFC type)."@en ;
    :producedInPhase phases:Execution ;
    :hasHardDependency :ProjectManagementPlan ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/reports/issue-report/> ;
    rdfs:isDefinedBy : .

:QualityAuditReport
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Quality Audit Report"@en ;
    skos:definition "Documents the results of structured quality checks confirming that deliverables and processes meet the defined quality standards."@en ;
    skos:scopeNote "In PRINCE2, quality review results are recorded as entries in the Quality Register."@en ;
    :producedInPhase phases:Execution ;
    :hasHardDependency :QualityManagementPlan ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/project-log/quality-register/> ;
    rdfs:isDefinedBy : .

# ══════════════════════════════════════════════════════════════════════════════
# PHASE 4 — MONITORING & CONTROL
# ══════════════════════════════════════════════════════════════════════════════

:StatusReport
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Status Report"@en ;
    skos:altLabel "Progress Report"@en ;
    skos:definition "Summarizes current project performance against the approved baseline across schedule, cost, and scope dimensions."@en ;
    skos:scopeNote "Equivalent to the PRINCE2 Highlight Report, produced periodically by the project manager for the project board."@en ;
    :producedInPhase phases:MonitoringControl ;
    :hasHardDependency :ProjectManagementPlan ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/reports/highlight-report/> ;
    rdfs:isDefinedBy : .

:RiskRegister
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Risk Register"@en ;
    skos:definition "Logs all identified risks with their current status, probability, impact, and the effectiveness of applied response strategies."@en ;
    skos:scopeNote "Directly equivalent to the PRINCE2 Risk Register."@en ;
    :producedInPhase phases:MonitoringControl ;
    :hasHardDependency :RiskManagementPlan ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/project-log/risk-register/> ;
    rdfs:isDefinedBy : .

:IssueLog
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Issue Log"@en ;
    skos:definition "Records problems that have occurred during the project and tracks their resolution status and assigned owner."@en ;
    skos:scopeNote "Equivalent to the PRINCE2 Issue Register."@en ;
    :producedInPhase phases:MonitoringControl ;
    :hasHardDependency :ProjectManagementPlan ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/project-log/issue-register/> ;
    rdfs:isDefinedBy : .

:DecisionLog
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Decision Log"@en ;
    skos:definition "Documents key decisions made during the project, including the rationale and alternatives considered, to ensure transparency and accountability."@en ;
    skos:scopeNote "Partially covered by the PRINCE2 Daily Log, which captures informal decisions and actions. A formal Decision Log is common in ISO 21502 practice but not a named PRINCE2 product."@en ;
    :producedInPhase phases:MonitoringControl ;
    :hasHardDependency :ProjectManagementPlan ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/project-log/daily-log/> ;
    rdfs:isDefinedBy : .

:ChangeLog
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Change Log"@en ;
    skos:definition "Tracks the status of all change requests from initial submission through to approval or rejection."@en ;
    skos:scopeNote "In PRINCE2, change tracking is handled via the Issue Register combined with the Issue Management Approach; a separate Change Log is common in ISO 21502 practice."@en ;
    :producedInPhase phases:MonitoringControl ;
    :hasHardDependency :ChangeRequest ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/baselines/management-approaches/issue/> ;
    rdfs:isDefinedBy : .

# ══════════════════════════════════════════════════════════════════════════════
# PHASE 5 — CLOSURE
# ══════════════════════════════════════════════════════════════════════════════

:HandoverDocument
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Handover Document"@en ;
    skos:altLabel "Handover Documentation"@en ;
    skos:definition "Provides all information necessary for the receiving party to operate, maintain, and support the project deliverables after closure."@en ;
    skos:scopeNote "In PRINCE2, handover information is captured within the End Project Report. A standalone handover document is common in ISO 21502 and DIN 69901 practice."@en ;
    :producedInPhase phases:Closure ;
    :hasHardDependency :DeliverableStatusReport ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/reports/end-project-report/> ;
    rdfs:isDefinedBy : .

:FinalProjectReport
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Final Project Report"@en ;
    skos:definition "Summarizes project performance, achievement of objectives, and the final status of all deliverables, milestones, and baselines."@en ;
    skos:scopeNote "Directly equivalent to the PRINCE2 End Project Report."@en ;
    :producedInPhase phases:Closure ;
    :hasHardDependency :StatusReport ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/reports/end-project-report/> ;
    rdfs:isDefinedBy : .

:LessonsLearnedReport
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Lessons Learned Report"@en ;
    skos:definition "Captures knowledge and insights gained during the project — what worked, what did not, and recommendations for improving future project performance."@en ;
    skos:scopeNote "Equivalent to the PRINCE2 Lessons Report, produced from entries in the Lessons Log."@en ;
    :producedInPhase phases:Closure ;
    :hasHardDependency :IssueLog ;
    :hasHardDependency :RiskRegister ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/reports/lessons-report/> ;
    rdfs:isDefinedBy : .

:ArchiveIndex
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Archive Index"@en ;
    skos:definition "Lists all project documents and records formally stored for long-term retention, serving as the definitive index of the project archive."@en ;
    skos:scopeNote "Closest PRINCE2 equivalent is the Product Register (formerly Configuration Item Records), which tracks all project products. The Archive Index is broader, covering all documentation."@en ;
    rdfs:comment "Depends on all produced project documents. This all-documents dependency is expressed narratively rather than enumerated as individual triples."@en ;
    :producedInPhase phases:Closure ;
    :hasHardDependency :FinalProjectReport ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/project-log/product-register/> ;
    rdfs:isDefinedBy : .

:ProjectClosureStatement
    a owl:Class ;
    rdfs:subClassOf foaf:Document, prov:Entity ;
    rdfs:label "Project Closure Statement"@en ;
    skos:definition "Formally confirms that all project activities are complete, deliverables have been accepted, and the project is officially closed."@en ;
    skos:scopeNote "In PRINCE2, formal closure is confirmed via the End Project Report accepted by the project board. A standalone closure statement is common in ISO 21502 and DIN 69901 practice."@en ;
    :producedInPhase phases:Closure ;
    :hasHardDependency :FinalProjectReport ;
    dct:source <https://www.iso.org/standard/74947.html> ;
    rdfs:seeAlso <https://prince2.wiki/management-products/reports/end-project-report/> ;
    rdfs:isDefinedBy : .
