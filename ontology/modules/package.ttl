@prefix :      <https://stephen-mcelhose.github.io/project-management-ontology/> .
@prefix phases: <https://stephen-mcelhose.github.io/project-management-ontology/phases/> .
@prefix pkgs:  <https://stephen-mcelhose.github.io/project-management-ontology/packages/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

# ── Package Module ─────────────────────────────────────────────────────────────
# A DocumentPackage is a named collection of document types that together
# constitute the documentary output of a project phase.
#
# Analogous to the ArtifactBundle / RegistryEntry concept in okf-agent:
#   Template + Instructions = what the agent helps fill
#   DocumentPackage         = the named set of documents the agent is filling
#
# Packages are schema-level individuals — they define what SHOULD be produced
# in each phase for every project, not a specific project's documents.
#
# The 5 standard packages align with the DIN 69901 phase structure defined
# in phase.ttl. Each package lists its member document classes via
# pm:includesDocument and declares which phase it gates via pm:gatesPhase.

# ── Class ──────────────────────────────────────────────────────────────────────

:DocumentPackage
    a owl:Class ;
    rdfs:label "Document Package"@en ;
    rdfs:comment "A named collection of document types that together constitute the documentary deliverable for a project phase. Completing a package is a prerequisite for closing that phase."@en ;
    skos:example "The Initiation Package bundles ProjectProposal, BusinessCase, ProjectCharter, StakeholderRegister, and RequirementSpecification."@en ;
    rdfs:isDefinedBy : .

# ── Properties ─────────────────────────────────────────────────────────────────

:includesDocument
    a owl:ObjectProperty ;
    rdfs:domain :DocumentPackage ;
    rdfs:range owl:Class ;
    rdfs:label "includes document"@en ;
    rdfs:comment "A document class (subclass of foaf:Document) that is a required member of this package."@en ;
    rdfs:isDefinedBy : .

:gatesPhase
    a owl:ObjectProperty ;
    rdfs:domain :DocumentPackage ;
    rdfs:range :PhaseType ;
    rdfs:label "gates phase"@en ;
    rdfs:comment "The phase that cannot be formally closed until this package is complete."@en ;
    rdfs:isDefinedBy : .

:hasPackage
    a owl:ObjectProperty ;
    rdfs:domain :PhaseType ;
    rdfs:range :DocumentPackage ;
    owl:inverseOf :gatesPhase ;
    rdfs:label "has package"@en ;
    rdfs:comment "The document package associated with this phase type."@en ;
    rdfs:isDefinedBy : .

# ── Standard phase packages (schema-level individuals) ─────────────────────────
# These are the canonical document sets for each DIN 69901 phase.
# Every project should produce the documents listed here before phase closure.

pkgs:InitiationPackage
    a :DocumentPackage ;
    rdfs:label "Initiation Package"@en ;
    skos:definition "The set of documents required to formally authorize a project and establish its scope, stakeholders, and high-level requirements."@en ;
    :gatesPhase phases:Initiation ;
    :includesDocument :ProjectProposal ;
    :includesDocument :BusinessCase ;
    :includesDocument :ProjectCharter ;
    :includesDocument :StakeholderRegister ;
    :includesDocument :RequirementSpecification ;
    rdfs:isDefinedBy : .

pkgs:PlanningPackage
    a :DocumentPackage ;
    rdfs:label "Planning Package"@en ;
    skos:definition "The set of documents required to establish the project baseline: how the work will be done, by whom, on what schedule, for how much, and with what risk controls."@en ;
    :gatesPhase phases:Planning ;
    :includesDocument :ProjectManagementPlan ;
    :includesDocument :WorkBreakdownStructure ;
    :includesDocument :ProjectSchedule ;
    :includesDocument :ResourcePlan ;
    :includesDocument :CostEstimate ;
    :includesDocument :RiskManagementPlan ;
    :includesDocument :QualityManagementPlan ;
    :includesDocument :CommunicationPlan ;
    rdfs:isDefinedBy : .

pkgs:ExecutionPackage
    a :DocumentPackage ;
    rdfs:label "Execution Package"@en ;
    skos:definition "The set of documents produced during delivery: work authorisations, progress reports, change requests, and quality evidence."@en ;
    :gatesPhase phases:Execution ;
    :includesDocument :WorkPackageDescription ;
    :includesDocument :DeliverableStatusReport ;
    :includesDocument :ChangeRequest ;
    :includesDocument :QualityAuditReport ;
    rdfs:isDefinedBy : .

pkgs:MonitoringControlPackage
    a :DocumentPackage ;
    rdfs:label "Monitoring & Control Package"@en ;
    skos:definition "The set of living registers and logs maintained throughout the project to track performance, risks, issues, decisions, and changes."@en ;
    :gatesPhase phases:MonitoringControl ;
    :includesDocument :StatusReport ;
    :includesDocument :RiskRegister ;
    :includesDocument :IssueLog ;
    :includesDocument :DecisionLog ;
    :includesDocument :ChangeLog ;
    rdfs:isDefinedBy : .

pkgs:ClosurePackage
    a :DocumentPackage ;
    rdfs:label "Closure Package"@en ;
    skos:definition "The set of documents required to formally close the project: handover evidence, final performance summary, lessons learned, and the archive index."@en ;
    :gatesPhase phases:Closure ;
    :includesDocument :HandoverDocument ;
    :includesDocument :FinalProjectReport ;
    :includesDocument :LessonsLearnedReport ;
    :includesDocument :ArchiveIndex ;
    :includesDocument :ProjectClosureStatement ;
    rdfs:isDefinedBy : .
