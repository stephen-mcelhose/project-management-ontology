# Copy to .env — gitignored. Existing shell env always wins over .env values.

# ── Vertex AI + Application Default Credentials (default, no key needed) ──────
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
AGENT_MODEL=gemini-2.0-flash

# ── AI Studio / local alt (set USE_VERTEXAI=false and provide a key) ──────────
# GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_API_KEY=
