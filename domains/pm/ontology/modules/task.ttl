@prefix : <https://stephen-mcelhose.github.io/process-assistant/pm/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .

# ── Task Module ────────────────────────────────────────────────────────────────

:Task
    a owl:Class ;
    rdfs:subClassOf prov:Activity, schema:Action ;
    rdfs:label "Task"@en ;
    rdfs:comment "A discrete unit of work within a project or phase."@en ;
    rdfs:isDefinedBy : .

:hasTask
    a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( :Project :Phase ) ] ;
    rdfs:range :Task ;
    rdfs:label "has task"@en ;
    rdfs:isDefinedBy : .

:dependsOn
    a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:domain :Task ;
    rdfs:range :Task ;
    rdfs:label "depends on"@en ;
    rdfs:comment "A predecessor task that must complete before this task can start."@en ;
    rdfs:isDefinedBy : .

:TaskStatus
    a owl:Class ;
    rdfs:label "Task Status"@en ;
    rdfs:isDefinedBy : .

:task-status-not-started  a :TaskStatus ; rdfs:label "Not Started"@en .
:task-status-in-progress  a :TaskStatus ; rdfs:label "In Progress"@en .
:task-status-blocked      a :TaskStatus ; rdfs:label "Blocked"@en .
:task-status-done         a :TaskStatus ; rdfs:label "Done"@en .

:taskStatus
    a owl:ObjectProperty ;
    rdfs:domain :Task ;
    rdfs:range :TaskStatus ;
    rdfs:label "task status"@en ;
    rdfs:isDefinedBy : .

:priority
    a owl:DatatypeProperty ;
    rdfs:domain :Task ;
    rdfs:range xsd:integer ;
    rdfs:label "priority"@en ;
    rdfs:comment "Numeric priority (lower = higher priority)."@en ;
    rdfs:isDefinedBy : .

:estimatedEffort
    a owl:DatatypeProperty ;
    rdfs:domain :Task ;
    rdfs:range xsd:decimal ;
    rdfs:label "estimated effort"@en ;
    rdfs:comment "Effort estimate in person-hours."@en ;
    rdfs:isDefinedBy : .
