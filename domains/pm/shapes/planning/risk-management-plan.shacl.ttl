# domains/pm/shapes/planning/risk-management-plan.shacl.ttl
#
# SHACL PRIMER — what is this file?
# ─────────────────────────────────
# SHACL (Shapes Constraint Language, W3C 2017) defines rules that an RDF graph
# must satisfy. Think of it as a type checker / schema validator for ontology data.
#
# When a Risk Management Plan is "ingested" (converted from the filled template.md
# into RDF), this file is what tells us whether the RDF is valid.
#
# How to read a shape:
#
#   sh:targetClass pm:RiskManagementPlan
#     → "these rules apply to any node of type pm:RiskManagementPlan"
#
#   sh:property [ sh:path dct:title ; sh:minCount 1 ]
#     → "every RiskManagementPlan instance must have at least one dct:title triple"
#
#   sh:message "..."
#     → the error message a human sees when validation fails
#
# To run validation:
#   pip install pyshacl
#   pyshacl -s domains/pm/shapes/planning/risk-management-plan.shacl.ttl \
#            -d path/to/my-risk-management-plan.ttl
#
# ── Prefixes ──────────────────────────────────────────────────────────────────

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix pm:    <https://stephen-mcelhose.github.io/process-assistant/pm/> .
@prefix pm-sh: <https://stephen-mcelhose.github.io/process-assistant/pm/shapes/> .

# ── Shape definition ──────────────────────────────────────────────────────────

pm-sh:RiskManagementPlanShape
    a sh:NodeShape ;

    sh:targetClass pm:RiskManagementPlan ;

    rdfs:label "Risk Management Plan shape"@en ;
    rdfs:comment "Validates that a filled Risk Management Plan instance satisfies the minimum requirements of ISO 21502:2020 and the PRINCE2® Risk Management Approach quality criteria."@en ;

    # ── Required: title ─────────────────────────────────────────────────────
    sh:property [
        sh:path     dct:title ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 3 ;
        sh:message  "A Risk Management Plan must have a dct:title (the project name)."@en ;
    ] ;

    # ── Required: description / scope ───────────────────────────────────────
    sh:property [
        sh:path     dct:description ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "A Risk Management Plan must have a dct:description (scope of risk management)."@en ;
    ] ;

    # ── Required: at least one seed risk ────────────────────────────────────
    # The PRINCE2 Risk Management Approach requires identification of risks
    # from the project initiation; an empty risk register is a quality failure.
    sh:property [
        sh:path     pm:hasRisk ;
        sh:minCount 1 ;
        sh:class    pm:Risk ;
        sh:message  "A Risk Management Plan must reference at least one identified risk (pm:hasRisk)."@en ;
    ] ;

    # ── Required: risk tolerance ─────────────────────────────────────────────
    # PRINCE2 quality criterion: risk tolerance and escalation threshold must
    # be clearly defined and aligned with the Project Board.
    sh:property [
        sh:path     pm:hasTolerance ;
        sh:minCount 1 ;
        sh:class    pm:Tolerance ;
        sh:message  "A Risk Management Plan must define a risk tolerance threshold (pm:hasTolerance)."@en ;
    ] ;

    # ── Required: project link ──────────────────────────────────────────────
    sh:property [
        sh:path     pm:describesProject ;
        sh:minCount 1 ;
        sh:class    pm:Project ;
        sh:message  "A Risk Management Plan must reference the project it describes via pm:describesProject."@en ;
    ] ;

    # ── Required: produced in Planning phase ─────────────────────────────────
    sh:property [
        sh:path     pm:producedInPhase ;
        sh:minCount 1 ;
        sh:hasValue <https://stephen-mcelhose.github.io/process-assistant/pm/phases/Planning> ;
        sh:message  "A Risk Management Plan must be linked to the Planning phase."@en ;
    ] ;

    # ── Required: creation date ──────────────────────────────────────────────
    sh:property [
        sh:path     dct:created ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message  "A Risk Management Plan must record the date it was created (dct:created)."@en ;
    ] ;

    # ── Required: creator ────────────────────────────────────────────────────
    sh:property [
        sh:path     dct:creator ;
        sh:minCount 1 ;
        sh:message  "A Risk Management Plan must identify its author (dct:creator)."@en ;
    ] .
