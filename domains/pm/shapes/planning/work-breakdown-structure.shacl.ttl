# domains/pm/shapes/planning/work-breakdown-structure.shacl.ttl
#
# SHACL PRIMER — what is this file?
# ─────────────────────────────────
# SHACL (Shapes Constraint Language, W3C 2017) defines rules that an RDF graph
# must satisfy. Think of it as a type checker / schema validator for ontology data.
#
# When a Work Breakdown Structure is "ingested" (converted from the filled
# template.md into RDF), this file is what tells us whether the RDF is valid.
#
# How to read a shape:
#
#   sh:targetClass pm:WorkBreakdownStructure
#     → "these rules apply to any node of type pm:WorkBreakdownStructure"
#
#   sh:property [ sh:path dct:title ; sh:minCount 1 ]
#     → "every WorkBreakdownStructure instance must have at least one dct:title triple"
#
#   sh:message "..."
#     → the error message a human sees when validation fails
#
# To run validation:
#   pip install pyshacl
#   pyshacl -s domains/pm/shapes/planning/work-breakdown-structure.shacl.ttl \
#            -d path/to/my-work-breakdown-structure.ttl
#
# ── Prefixes ──────────────────────────────────────────────────────────────────

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix pm:    <https://stephen-mcelhose.github.io/process-assistant/pm/> .
@prefix pm-sh: <https://stephen-mcelhose.github.io/process-assistant/pm/shapes/> .

# ── Shape definition ──────────────────────────────────────────────────────────

pm-sh:WorkBreakdownStructureShape
    a sh:NodeShape ;

    sh:targetClass pm:WorkBreakdownStructure ;

    rdfs:label "Work Breakdown Structure shape"@en ;
    rdfs:comment "Validates that a filled Work Breakdown Structure instance satisfies the minimum requirements of ISO 21502:2020 and DIN 69901-3 (Projektstrukturplan)."@en ;

    # ── Required: title ─────────────────────────────────────────────────────
    sh:property [
        sh:path     dct:title ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 3 ;
        sh:message  "A Work Breakdown Structure must have a dct:title (the project name)."@en ;
    ] ;

    # ── Required: description ────────────────────────────────────────────────
    sh:property [
        sh:path     dct:description ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "A Work Breakdown Structure must have a dct:description."@en ;
    ] ;

    # ── Required: at least one deliverable ──────────────────────────────────
    sh:property [
        sh:path     pm:hasDeliverable ;
        sh:minCount 1 ;
        sh:class    pm:Deliverable ;
        sh:message  "A Work Breakdown Structure must reference at least one top-level deliverable (pm:hasDeliverable)."@en ;
    ] ;

    # ── Required: at least one work package (task) ──────────────────────────
    sh:property [
        sh:path     pm:hasTask ;
        sh:minCount 1 ;
        sh:class    pm:Task ;
        sh:message  "A Work Breakdown Structure must contain at least one work package (pm:hasTask)."@en ;
    ] ;

    # ── Required: project link ──────────────────────────────────────────────
    sh:property [
        sh:path     pm:describesProject ;
        sh:minCount 1 ;
        sh:class    pm:Project ;
        sh:message  "A Work Breakdown Structure must reference the project it describes via pm:describesProject."@en ;
    ] ;

    # ── Required: produced in Planning phase ─────────────────────────────────
    sh:property [
        sh:path     pm:producedInPhase ;
        sh:minCount 1 ;
        sh:hasValue <https://stephen-mcelhose.github.io/process-assistant/pm/phases/Planning> ;
        sh:message  "A Work Breakdown Structure must be linked to the Planning phase."@en ;
    ] ;

    # ── Required: creation date ──────────────────────────────────────────────
    sh:property [
        sh:path     dct:created ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message  "A Work Breakdown Structure must record the date it was created (dct:created)."@en ;
    ] ;

    # ── Required: creator ────────────────────────────────────────────────────
    sh:property [
        sh:path     dct:creator ;
        sh:minCount 1 ;
        sh:message  "A Work Breakdown Structure must identify its author (dct:creator)."@en ;
    ] .
