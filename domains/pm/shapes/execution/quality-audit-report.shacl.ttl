# domains/pm/shapes/execution/quality-audit-report.shacl.ttl
#
# SHACL PRIMER — what is this file?
# ─────────────────────────────────
# SHACL (Shapes Constraint Language, W3C 2017) defines rules that an RDF graph
# must satisfy. Think of it as a type checker / schema validator for ontology data.
#
# When a Quality Audit Report is "ingested" (converted from the filled template.md
# into RDF), this file is what tells us whether the RDF is valid.
#
# How to read a shape:
#
#   sh:targetClass pm:QualityAuditReport
#     → "these rules apply to any node of type pm:QualityAuditReport"
#
#   sh:property [ sh:path dct:identifier ; sh:minCount 1 ]
#     → "every QualityAuditReport instance must have at least one dct:identifier triple"
#
#   sh:message "..."
#     → the error message a human sees when validation fails
#
# To run validation:
#   pip install pyshacl
#   pyshacl -s domains/pm/shapes/execution/quality-audit-report.shacl.ttl \
#            -d path/to/my-quality-audit-report.ttl
#
# ── Prefixes ──────────────────────────────────────────────────────────────────

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix proj:  <https://linked.data.gov.au/def/project#> .
@prefix pm:    <https://stephen-mcelhose.github.io/process-assistant/pm/> .
@prefix pm-sh: <https://stephen-mcelhose.github.io/process-assistant/pm/shapes/> .

# ── Shape definition ──────────────────────────────────────────────────────────

pm-sh:QualityAuditReportShape
    a sh:NodeShape ;

    # Target: applies to any RDF node typed as pm:QualityAuditReport
    sh:targetClass pm:QualityAuditReport ;

    rdfs:label "Quality Audit Report shape"@en ;
    rdfs:comment "Validates that a filled Quality Audit Report instance satisfies the minimum information requirements of ISO 21502:2020 §8 and PRINCE2® Quality Register entry quality criteria."@en ;

    # ── Required: title (audit ID as display title) ─────────────────────────
    # Maps to the {{audit_id}} slot rendered in the document H1.
    sh:property [
        sh:path     dct:title ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 2 ;
        sh:message  "A Quality Audit Report must have a dct:title (the audit identifier, e.g. QA-001)."@en ;
    ] ;

    # ── Required: unique identifier (Quality Register reference) ───────────
    # Maps to the {{audit_id}} slot — must be consistent with the project's
    # Quality Register numbering scheme.
    sh:property [
        sh:path     dct:identifier ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "A Quality Audit Report must have a dct:identifier (the unique audit number consistent with the Quality Register)."@en ;
    ] ;

    # ── Required: description (audit summary / result summary) ─────────────
    sh:property [
        sh:path     dct:description ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "A Quality Audit Report must have a dct:description (summary of the quality review and findings)."@en ;
    ] ;

    # ── Required: product reviewed ──────────────────────────────────────────
    # Validates that the report is linked to a specific deliverable.
    sh:property [
        sh:path     pm:hasDeliverable ;
        sh:minCount 1 ;
        sh:class    pm:Deliverable ;
        sh:message  "A Quality Audit Report must reference the deliverable it reviewed (pm:hasDeliverable)."@en ;
    ] ;

    # ── Required: acceptance criteria applied ──────────────────────────────
    # Quality criteria must be explicitly documented per PRINCE2 Quality
    # Register quality standards.
    sh:property [
        sh:path     pm:acceptanceCriteria ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "A Quality Audit Report must document the acceptance criteria applied in the review (pm:acceptanceCriteria)."@en ;
    ] ;

    # ── Required: project link ──────────────────────────────────────────────
    sh:property [
        sh:path     pm:describesProject ;
        sh:minCount 1 ;
        sh:class    pm:Project ;
        sh:message  "A Quality Audit Report must reference the project it belongs to via pm:describesProject."@en ;
    ] ;

    # ── Required: produced in Execution phase ───────────────────────────────
    sh:property [
        sh:path     pm:producedInPhase ;
        sh:minCount 1 ;
        sh:hasValue <https://stephen-mcelhose.github.io/process-assistant/pm/phases/Execution> ;
        sh:message  "A Quality Audit Report must be linked to the Execution phase."@en ;
    ] ;

    # ── Required: actual review date ────────────────────────────────────────
    sh:property [
        sh:path     dct:created ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message  "A Quality Audit Report must record the date the review took place (dct:created)."@en ;
    ] ;

    # ── Required: creator / reviewer ───────────────────────────────────────
    sh:property [
        sh:path     dct:creator ;
        sh:minCount 1 ;
        sh:message  "A Quality Audit Report must identify the reviewer(s) who conducted the audit (dct:creator)."@en ;
    ] .
